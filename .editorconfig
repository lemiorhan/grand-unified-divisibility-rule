# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{groovy,gradle}]
indent_size = 4

[*.{js,css,html}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
# trailing whitespace is a hard line break in Markdown
trim_trailing_whitespace = false

[{LICENSE,LICENSE-DOCS,NOTICE}]
# verbatim legal texts — never reformat these
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = false
max_line_length = unset

[gradlew]
end_of_line = lf

[*.bat]
end_of_line = crlf
